# .env.prod — SOLO en el servidor, NO commitear valores reales
# En build de Vite estas vars quedan fijas en dist/, si cambian hay que rebuild.
# El compose de producción fija estos valores como build args; este archivo es
# solo referencia. <SERVER_IP> = dominio o IP del servidor (API en el puerto 8002).
# VITE_SOCKET_URL es la base (sin namespace): el namespace sale de los contratos.
VITE_API_URL=http://<SERVER_IP>:8002
VITE_SOCKET_URL=http://<SERVER_IP>:8002
