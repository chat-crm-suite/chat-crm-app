# .env.prod — SOLO en el servidor, NO commitear valores reales
# En build de Vite estas vars quedan fijas en dist/, si cambian hay que rebuild.
# <SERVER_IP> = IP del servidor en tu red (ej. Tailscale), API en 3000.
# VITE_SOCKET_URL es la base (sin namespace): el namespace sale de los contratos.
VITE_API_URL=http://<SERVER_IP>:3000
VITE_SOCKET_URL=http://<SERVER_IP>:3000
APP_PORT=8081
